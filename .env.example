# Copia este archivo como .env y llena los valores. Nunca subas .env a git.
# Base de datos PostgreSQL (si falta, se usa una base en memoria para pruebas)
DATABASE_URL=
# Usuario administrador que se crea la primera vez
ADMIN_USER=admin
ADMIN_PASSWORD=
# Clave larga y aleatoria (mínimo 32 caracteres) para firmar las sesiones
SESSION_SECRET=
# URL pública del sitio (para el regreso desde la página de pago)
PUBLIC_URL=
# Pago en línea (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
